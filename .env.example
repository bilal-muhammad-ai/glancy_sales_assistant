# Website to use as knowledge base
SITE_BASE_URL=https://www.glancyfawcett.com

# Chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=site_kb

# Ollama embeddings (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Crawl tuning
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=200
CRAWL_TIMEOUT_S=30
MIN_TEXT_CHARS=100

# Chunking
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100

# LLM (Groq) — required for POST /ask and voice bot
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Speech (Deepgram STT + Aura TTS) — required for voice bot
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# Optional (unused by current voice MVP)
CARTESIA_API_KEY=
DAILY_API_KEY=
DAILY_ROOM_URL=
