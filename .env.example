# Website to use as knowledge base
SITE_BASE_URL=https://www.glancyfawcett.com

# Chroma
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=site_kb

# Ollama embeddings (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Crawl tuning
CRAWL_CONCURRENCY=4
CRAWL_DELAY_MS=200
CRAWL_TIMEOUT_S=30
MIN_TEXT_CHARS=100

# Chunking
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=100

# LLM (Groq) — used later for answers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Speech (later)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# Browser transport (Daily) — optional until voice is wired
DAILY_API_KEY=
DAILY_ROOM_URL=
